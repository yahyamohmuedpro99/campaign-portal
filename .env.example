# Copy to .env and fill in. .env is git-ignored and must never be committed:
# this repository is public.

# --- Supabase -----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key: safe in the browser, RLS applies>
SUPABASE_SERVICE_ROLE_KEY=<service role key: server only, bypasses RLS>
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<database password, used by the CLI importer and migrations>
# Session-mode pooler. Direct db.<ref>.supabase.co is IPv6-only on the free plan.
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=5432

# --- Messaging provider -------------------------------------------------------------
PROVIDER_BASE_URL=https://dispatcher-production-72fc.up.railway.app
PROVIDER_API_KEY=<the vgk_... key issued for this candidate>

# --- Application --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bearer token that lets the scheduled poller call /api/jobs/tick.
JOB_SECRET=<random 32 bytes, base64url>
# Signs the short-lived cookie issued after a share-link password is accepted.
SHARE_SESSION_SECRET=<random 32 bytes, base64url>

# --- Seeded portal logins -----------------------------------------------------------
SEED_PASSWORD_KILELE_OWNER=
SEED_PASSWORD_KILELE_ANALYST=
SEED_PASSWORD_KAROO_OWNER=
SEED_PASSWORD_KAROO_ANALYST=
SEED_PASSWORD_MARRAKECH_OWNER=
SEED_PASSWORD_MARRAKECH_ANALYST=

# Google sign-in. From the OAuth client in Google Cloud Console; see
# docs/google-sign-in-setup.md. Read at `supabase config push` time and never written
# into supabase/config.toml, which is committed.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
